compile_commands.json

# Firebase local state
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log

# Firebase project files (local deployment config and rules, never committed)
.firebaserc
firebase.json
firestore.rules
firestore.indexes.json

# Firebase client configuration for this app
/app/google-services.json

# NOTE about core/: its upstream .gitignore also ignores FFmpeg static libraries
